{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "/home/dutra/Imagens/frirem.png",
    "type": "kitty",
    "width": 35,
    "height": 16
  },

  "display": {
    "separator": "   ",
    "color": ""
  },

  "modules": [
    {
      "type": "title",
      "format": "╭────────────────── \u001b[35m{user-name}\u001b[0m"
    },

{
      "type": "custom",
      "format": "│ System Information"
},

    {
      "type": "os",
      "key": "│  \u001b[35m󰣇 OS\u001b[0m",
    },
    {
      "type": "kernel",
      "key": "│  \u001b[35m󰒋 Kernel\u001b[0m"
    },
    {
      //"format":"│  {key}",
      "type": "uptime",
      "key": "│  \u001b[35m󰅐 Uptime\u001b[0m",
    },
    {
      "type": "packages",
      "key": "│  \u001b[35m󰏖 Packages\u001b[0m"
    },


    {
      "type": "custom",
      "key": "│",
},



{
      "type": "custom",
      "format": "│ Desktop Environment",
},
    {
      "type": "De",
      "key": "│  \u001b[35m󰧨 DE\u001b[0m"
    },
    {
      "type": "wm",
      "key": "│  \u001b[35m󰖲 WM\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "│  \u001b[35m󰆍 Terminal\u001b[0m"
    },
    {
      "type": "shell",
      "key": "│  \u001b[35m󰆍 Shell\u001b[0m"
    },
    {
      "type": "Display",
      "key": "│  \u001b[35m󰧨 DE\u001b[0m"
    },

    {
      "type": "custom",
      "format": "│",
},

{
      "type": "custom",
      "format": "│ Hardware Information",
},
    {
      "type": "cpu",
      "key": "│  \u001b[35m󰻠 CPU\u001b[0m"
    },
    {
      "type": "gpu",
      "key": "│  \u001b[35m󰍛 GPU\u001b[0m"
    },
    {
      "type": "memory",
      "key": "│  \u001b[35m󰘚 Memory\u001b[0m"
    },
    {
      "type": "disk",
      "key": "│  \u001b[35m󰋊 Disk\u001b[0m",
    },
    {
      "type": "LocalIp",
      "key": "│  \u001b[35m IP\u001b[0m"
    },

      " colors",

    {
      "type": "custom",
      "format": "╰───────────────────────────────────────────────────╯",
},


  ],
}
